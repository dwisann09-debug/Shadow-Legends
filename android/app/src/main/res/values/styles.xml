<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#090710</item>
        <item name="colorPrimaryDark">#090710</item>
        <item name="colorAccent">#fbbf24</item>
        <item name="android:windowBackground">#090710</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#090710</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#090710</item>
        <item name="android:navigationBarColor">#090710</item>
    </style>

</resources>
